# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
DATABASE_FILE=./data/deepan.db
CORS_ORIGINS=http://localhost:5173

# --- Alerts ---
# Notifications are delivered in-app to the reception desk feed (Alerts tab).
# There is no SMS gateway: that required DLT registration, template approval
# and a per-message cost, for something staff read on screen anyway.
# Include the patient's name in the desk feed. On by default — the feed is
# behind a staff login and never leaves the hospital's own systems.
# NOTIFY_INCLUDE_PATIENT_NAME=true

# --- Payments ---
# Leave blank to run counter-payment only. Test keys start with rzp_test_.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
CONVENIENCE_FEE=20

# --- Teleconsultation ---
# jitsi  = rooms generated automatically on meet.jit.si. Free, no account.
# manual = staff paste a Meet/Zoom link per consultation.
VIDEO_PROVIDER=jitsi
# JITSI_HOST=meet.jit.si
# REQUIRED in production. A Jitsi room is public to anyone who knows its name,
# so room names are an HMAC of the appointment id using this secret. Without
# it, names change on every restart. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# VIDEO_ROOM_SECRET=

# --- Booking rules ---
SLOT_MINUTES=20
BOOKING_WINDOW_DAYS=30
BOOKING_LEAD_MINUTES=30
TIMEZONE=Asia/Kolkata
HOSPITAL_NAME=Deepan Hospital

# --- Production only ---
# COOKIE_SECURE=true
# OTP_ECHO=false

# --- Reception desk hours ---
# A booking made while the desk is staffed waits for approval; one made when
# it is closed is confirmed outright, so nothing sits in a queue nobody is
# watching. Set BOOKING_APPROVAL=never to switch approval off entirely.
BOOKING_APPROVAL=desk-hours
DESK_OPENS_AT=08:00
DESK_CLOSES_AT=20:00

# --- Backups ---
# On by default. These land in server/backups/ on THIS machine — copy them
# somewhere else as well, or a dead disk takes the hospital's records with it.
BACKUP_ENABLED=true
BACKUP_EVERY_HOURS=6
BACKUP_KEEP=28

# --- Data protection (DPDP Act 2023) ---
# Bump PRIVACY_VERSION whenever the privacy notice wording changes: every
# patient is then asked to agree again rather than being treated as having
# agreed to something they never saw.
PRIVACY_VERSION=2026-08-05
PRIVACY_CONTACT=dnhtrichy@gmail.com
RETAIN_CANCELLED_DAYS=90
RETAIN_NOTIFICATION_DAYS=90
RETAIN_AUDIT_DAYS=365

# --- Read aloud (text to speech) ---
# Leave ELEVENLABS_API_KEY unset and the app still reads pages aloud, using the
# device's own speech. That is free and offline — but it is the robotic voice.
#
# Set a key and the server generates the audio with ElevenLabs instead, which
# is the difference between a satnav and a person. The key stays here and is
# never sent to the browser.
#
# Nothing else needs setting: the model and one voice per language are chosen
# automatically from your account on first use. Run `npm run voices` to see
# what was picked, or `npm run voices -- --try` to hear it.
#
# Billing is per character, so generated audio is cached on disk by content
# hash — the same page heading read a thousand times is generated once.
# ELEVENLABS_API_KEY=
#
# Only set these to override the automatic choice. `npm run voices` prints the
# available IDs. Delete server/data/speech after changing one, or the old voice
# is served from cache.
# ELEVENLABS_MODEL=
# ELEVENLABS_VOICE_EN=
# ELEVENLABS_VOICE_TA=
# ELEVENLABS_VOICE_HI=
# SPEECH_MAX_CHARS=800
# SPEECH_CACHE_MAX=2000

# --- Case-sheet charge, added to the doctor's consultation fee ---
# A first visit needs a new file opened, which costs more than pulling an
# existing one. Hospital-wide: the charge is for the paperwork, not the
# consultation, so it does not vary by doctor. Set either to 0 to switch off.
FIRST_VISIT_CHARGE=50
REVIEW_CHARGE=20

# --- WhatsApp (optional) ---
# A tel: link cannot place a call from a laptop: the browser hands off to the
# operating system, and unless something is registered for tel: the click does
# nothing at all. WhatsApp connects from a desktop and a phone alike, so if the
# hospital uses it, this is the contact route that always works.
# Set in the FRONT-END environment (a .env at the project root), not here:
#   VITE_WHATSAPP_PHONE=9843074989

# --- Klinique (the hospital's clinical system) ---
# deepan.klinique.net holds the physician portal and reception desk. This app
# is the public booking page in front of it, so bookings have to reach it.
#
# manual  — the default. Bookings are flagged for reception to enter, and ticked
#           off when they have. Needs nothing from the vendor.
# api     — bookings are POSTed to Klinique. Needs a base URL and key that the
#           hospital must obtain from Klinique; there is no public
#           documentation, and an endpoint carrying patient records is not
#           something to guess at.
# session — the server signs in to Klinique's web form and submits each booking
#           itself. No key needed. Brittle, and it uses a Klinique login, so
#           read KLINIQUE-AUTO.md before switching it on.
KLINIQUE_MODE=manual
# KLINIQUE_BASE_URL=https://deepan.klinique.net
#
# --- api mode ---
# KLINIQUE_API_KEY=
# Correct these two once Klinique documents their interface — no code change.
# KLINIQUE_APPOINTMENT_PATH=/api/appointments
# KLINIQUE_AUTH_HEADER=X-API-Key
#
# --- session mode (see KLINIQUE-AUTO.md; use a dedicated "Website Bookings"
#     account, never a person's) ---
# KLINIQUE_USERNAME=
# KLINIQUE_PASSWORD=
# Fill these from one captured booking:  npm run klinique-capture -- --file captured.txt
# KLINIQUE_BOOKING_PATH=
# KLINIQUE_BOOKING_NEW_PATH=
# KLINIQUE_FIELD_MAP=
# KLINIQUE_DOCTOR_MAP=
KLINIQUE_PORTAL_URL=https://deepan.klinique.net
